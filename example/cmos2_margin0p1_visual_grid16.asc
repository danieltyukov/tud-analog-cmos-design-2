TEXT -3504 -1456 Left 2 ;EE4525 CMOS2 0.1% margin final candidate - grid16 visual schematic
TEXT -3504 -1376 Left 2 ;Actual nch/pch MOS symbols. No switches, .ic, .nodeset, or uic. Measurement E-sources are probes only.
TEXT -3504 -816 Left 2 ;Supplies and differential input step
TEXT -2096 -1456 Left 2 ;CMOS1-style bias/reference block (separate Vddb, excluded from amplifier power)
TEXT -2096 -720 Left 2 ;Bias isolation and large decoupling caps
TEXT -3200 -120 Left 2 ;Gain-4 feedback/testbench network: Cin/Cfb=4, Rfb/Rin=4, Cload=Cin
TEXT -704 128 Left 2 ;First stage: differential pair + NMOS cascodes + cascoded PMOS loads
TEXT 672 336 Left 2 ;Second stage: complementary push-pull output
TEXT -696 1160 Left 2 ;Miller/nulling compensation and differential snubber
TEXT -1168 1536 Left 2 ;Real continuous-time MOS CMFB: resistor-sensed output CM, MOS differential pair, weak x-node correction
TEXT 48 56 Left 2 ;Weak CMFB correction devices on first-stage output nodes
TEXT -3504 1504 Left 2 ;.lib and options
TEXT -3504 1568 Left 2 !.lib "C:\\Program Files\\ADI\\LTspice\\lib\\cmp\\log018.l" TT\n.option plotwinsize=0 method=trap reltol=0.005\n.options logopinfo
TEXT -3504 1760 Left 2 ;Design parameters
TEXT -3504 1824 Left 2 !.param VDD=1.8 VCM=0.9 Cin=3.23735p Gfb=4.000 Cfb={Cin/Gfb} Cload={Cin}\n.param Rin=10Meg Rfb={4*Rin} VoutStep=1.1310 VinStep={VoutStep/4}\n.param tRelease=24n tstep=25n Tsettle=25n tstop=115n Kboltz=1.380649e-23 Tkelvin=300 KTCFAC=42\n.param L=1.8u LAMP=1.8u Wn=58u Wp=58u M1=1 L2=0.22u Wn2=1.898u Wp2=20.98u M2=1\n.param Cc=720f Rz=2.8k RSNUB=850 CSNUB=0.78p\n.param VBNTAIL=0.56 VBNCAS=1.10 VBPCAS=0.38 VBP=1.04 VBNCMFB=0.56 VBPCMF=1.00 VBIASDD=1.8\n.param IBNTAIL=125u IBNCAS=240u IBPMAIN=158u IBPCAS=80u IBPCMF=2.2u\n.param WBNTAIL=100u WBNCAS=100u WBPMAIN=100u WBPCAS=8u WBPCMF=1.5u MBIASN=2 MBIASP=2 BIAS_SCALE=10\n.param MBIASN_EFF={MBIASN*BIAS_SCALE} MBIASP_EFF={MBIASP*BIAS_SCALE} MBIAS1_EFF={BIAS_SCALE}\n.param CBIAS=1 RBIASISO=1k\n.param LCMFB=1.8u RCMFB_SENSE=2Meg WCMFB_LOAD=2u WCMFB_IN=2u WCMFB_TAIL=4u WCMFB_CORR=1u RCMFB_CORR=1k\n.param WCMFB_NCORR=0.25u RCMFB_NCORR=300k CCMFB=1p CCMSENSE=0
TEXT -3504 2480 Left 2 ;Measurement probes and transient setup
TEXT -3504 2544 Left 2 !Evg virtualground 0 vip vin 1\nEvoutd voutd 0 von vop 1\nEvcmout vcmout 0 VALUE={(V(vop)+V(von))/2}\n.op\n.tran 0 {tstop} 0 2p
TEXT -3504 2784 Left 2 ;Measurements
TEXT -3504 2848 Left 2 !.meas tran Verr_A_eval FIND V(virtualground) AT={tstep+Tsettle}\n.meas tran Asettle_dB PARAM 20*log10(VoutStep/(abs(Verr_A_eval)+1n))\n.meas tran Verr_A_max MAX abs(V(virtualground)) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Asettle_floor_dB PARAM 20*log10(VoutStep/(Verr_A_max+1n))\n.meas tran Voutd_for_abeta FIND V(voutd) AT={tstep+Tsettle}\n.meas tran Verr_Abeta_eval PARAM abs(VoutStep-Voutd_for_abeta)\n.meas tran Abeta_settle_dB PARAM 20*log10(VoutStep/(Verr_Abeta_eval+1n))\n.meas tran Verr_Abeta_max MAX abs(VoutStep-V(voutd)) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Abeta_floor_dB PARAM 20*log10(VoutStep/(Verr_Abeta_max+1n))\n.meas tran Vop_eval FIND V(vop) AT={tstep+Tsettle}\n.meas tran Von_eval FIND V(von) AT={tstep+Tsettle}\n.meas tran Xop_eval FIND V(xop) AT={tstep+Tsettle}\n.meas tran Xon_eval FIND V(xon) AT={tstep+Tsettle}\n.meas tran Vcmfb_eval FIND V(vcmfb) AT={tstep+Tsettle}\n.meas tran Vcm_sense_eval FIND V(vcm_sense) AT={tstep+Tsettle}\n.meas tran Vcmout_eval FIND V(vcmout) AT={tstep+Tsettle}\n.meas tran Vbntail_eval FIND V(vbntail) AT={tstep+Tsettle}\n.meas tran Vbncas_eval FIND V(vbncas) AT={tstep+Tsettle}\n.meas tran Vbpcas_eval FIND V(vbpcas) AT={tstep+Tsettle}\n.meas tran Vbp_eval FIND V(vbp) AT={tstep+Tsettle}\n.meas tran Vbpcmf_eval FIND V(vbpcmf) AT={tstep+Tsettle}\n.meas tran Voutd_eval FIND V(voutd) AT={tstep+Tsettle}\n.meas tran Voutd_50n FIND V(voutd) AT=50n\n.meas tran Voutd_60n FIND V(voutd) AT=60n\n.meas tran Voutd_70n FIND V(voutd) AT=70n\n.meas tran Voutd_90n FIND V(voutd) AT=90n\n.meas tran Voutd_115n FIND V(voutd) AT=115n\n.meas tran Voutd_min_floor MIN V(voutd) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Voutd_max_floor MAX V(voutd) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Vop_min_floor MIN V(vop) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Vop_max_floor MAX V(vop) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Von_min_floor MIN V(von) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Von_max_floor MAX V(von) FROM={tstep+Tsettle} TO={tstop}\n.meas tran T30_Abeta WHEN 20*log10(VoutStep/(abs(VoutStep-V(voutd))+1n))=30 TD={tstep} RISE=1\n.meas tran T386_Abeta WHEN 20*log10(VoutStep/(abs(VoutStep-V(voutd))+1n))=38.6 TD={tstep} RISE=1\n.meas tran Tau_Abeta PARAM T386_Abeta-T30_Abeta\n.meas tran Iavg AVG (-I(Vdd)) FROM={tstep+Tsettle} TO={tstop}\n.meas tran Pavg_mW PARAM VDD*Iavg*1000\n.meas tran Iavg_amp AVG (-I(Vdd)) FROM={tstep} TO={tstop}\n.meas tran Pavg_amp_mW PARAM VDD*Iavg_amp*1000\n.meas tran Iavg_bias AVG (-I(Vddb)) FROM={tstep} TO={tstop}\n.meas tran Pavg_bias_mW PARAM VBIASDD*Iavg_bias*1000\n.meas tran SNR_kTC_only_dB PARAM 66+10*log10(Cin/0.71p)+20*log10(VoutStep/1.4)
TEXT -3496 4280 Left 2 ;Saved waveforms
TEXT -3496 4344 Left 2 !.save V(vop) V(von) V(vip) V(vin) V(voutd) V(vcmout) V(virtualground) V(xop) V(xon) V(vcmfb) V(vcm_sense) V(cmfbtail) V(cmfb_ref) V(vbntail) V(vbncas) V(vbpcas) V(vbp) V(vbpcmf) I(Vdd) I(Vddb)
TEXT -1016 2960 Left 2 ;Noise mode: comment .tran/.meas tran, then uncomment these lines.
TEXT -1016 3048 Left 2 !;.noise V(voutd) Vinp dec 100 10k 100G\n;.meas noise Vn_rms_amp INTEG V(onoise) FROM=10k TO=100G\n;.meas noise SNR_amp_only_dB PARAM 20*log10((VoutStep/sqrt(2))/Vn_rms_amp)\n;.meas noise Vsignal_rms PARAM VoutStep/sqrt(2)\n;.meas noise Vn_kTC_rms PARAM sqrt(KTCFAC*Kboltz*Tkelvin/Cin)\n;.meas noise SNR_kTC_only_noise_dB PARAM 20*log10(Vsignal_rms/Vn_kTC_rms)
FLAG -3168 240 vp_input
FLAG -3168 512 vn_input
