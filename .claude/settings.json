{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run tools/*)",
      "Bash(uv sync)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff --stat)",
      "Bash(git diff tools/ brief/)",
      "Bash(git log --oneline -20)",
      "mcp__ltspice-asc"
    ],
    "deny": [
      "Edit(./legacy/**)",
      "Edit(./example/**)",
      "Edit(./brief/assignment.pdf)",
      "Edit(./brief/faq.txt)",
      "Edit(./brief/clarifications.md)",
      "Edit(./tools/selftest.py)",
      "Bash(uv run *..*)",
      "mcp__ltspice-asc__run_code"
    ]
  },
  "enabledMcpjsonServers": [
    "ltspice-asc"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-brief.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|mcp__ltspice-asc__edit_schematic|mcp__ltspice__write_schematic|mcp__ltspice__modify_component",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-asc.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
