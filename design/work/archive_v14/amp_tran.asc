TEXT 2096 264 Left 3 ;Stage 1 (complementary input)
TEXT 1584 264 Left 3 ;Stage 2A + comp.
TEXT 2944 264 Left 3 ;Stage 2B + comp.
TEXT 3616 264 Left 3 ;CMFB (continuous time)
TEXT 16 264 Left 3 ;Bias block (on Vddb, decoupled by Cbig)
TEXT 16 1752 Left 3 ;Fixed test bench (Cin/Cfb = 4, Cload = Cin)
TEXT 2432 1808 Left 2 !.lib 'log018.l' TT
TEXT 2432 1848 Left 2 !.param VDD=1.8 VCM=0.9 VCMI=0.86
TEXT 2432 1888 Left 2 !.param Cin=1.67p Cfb={Cin/4} Cload={Cin} Rin=100Meg Rfb={4*Rin}
TEXT 2432 1928 Left 2 !.param VoutStep=1.4 VinStep={VoutStep/4} tstep=10n Tsettle=25n tstop={tstep+Tsettle+45n} trise=50p
TEXT 2432 1968 Left 2 !.param Ib=9.0u
TEXT 2432 2008 Left 2 !.param Lip=0.25u Wip=7u Mip=3
TEXT 2432 2048 Left 2 !.param Lin=0.96u Win=8.3u Min=2
TEXT 2432 2088 Left 2 !.param Lt=0.5u Wt=5u Mt=5
TEXT 2432 2128 Left 2 !.param Ltn=1u Wtn=6.4u Mtn=3 Mtc=1
TEXT 2432 2168 Left 2 !.param Lcp=0.36u Wcp=11.75u Mcp=1
TEXT 2432 2208 Left 2 !.param Lcn=0.36u Wcn=8.35u Mcn=1
TEXT 2432 2248 Left 2 !.param Lon=0.36u Won=1.4u Mon=1
TEXT 2432 2288 Left 2 !.param Lop=0.25u Wop=15.2u Mop=2
TEXT 2432 2328 Left 2 !.param Cc=0.418p Cls=0.76p Rb=3Meg fcc=0.70
TEXT 2432 2368 Left 2 !.param Rcm=2Meg Ccm=50f
TEXT 2432 2408 Left 2 !.param Lcm=0.5u Wcm=4u Wctl=2.16u Wc3=1u
TEXT 2432 2448 Left 2 !.param tsc=0.81 knr=0.75 kn={knr*Mt*tsc/Mtn} ko=0.55 kcn=0.6 kcp=0.57
TEXT 2432 2488 Left 2 !.param Wbcn=0.4u Lbcn=4u Wbcp=1u Lbcp=4u
TEXT 2432 2528 Left 2 !.param Cbig=10n
TEXT 2432 2568 Left 2 !.tran 0 {tstop} 0 2p
TEXT 2432 2608 Left 2 !.option plotwinsize=0 method=trap reltol=1e-4
TEXT 2432 2648 Left 2 !.meas tran vg25 FIND V(vip,vin) AT={tstep+Tsettle}
TEXT 2432 2688 Left 2 !.meas tran vod25 FIND V(von,vop) AT={tstep+Tsettle}
TEXT 2432 2728 Left 2 !.meas tran A25 PARAM 20*log10(VoutStep/(abs(vg25)+1n))
TEXT 2432 2768 Left 2 !.meas tran Ab25 PARAM 20*log10(VoutStep/(abs(VoutStep-vod25)+1n))
TEXT 2432 2808 Left 2 !.meas tran errmax MAX abs(VoutStep-V(von,vop)) FROM={tstep+Tsettle} TO={tstop}
TEXT 2432 2848 Left 2 !.meas tran Abfloor PARAM 20*log10(VoutStep/(errmax+1n))
TEXT 2432 2888 Left 2 !.meas tran Iset AVG -I(Vdd) FROM={tstep} TO={tstep+Tsettle}
TEXT 2432 2928 Left 2 !.meas tran Iq AVG -I(Vdd) FROM={tstep-5n} TO={tstep}
TEXT 2432 2968 Left 2 !.meas tran P_mW PARAM 1.8*max(Iset,Iq)*1e3
TEXT 2416 1752 Left 3 ;Parameters, Simulations & Measurements
