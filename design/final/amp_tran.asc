TEXT 16 264 Left 3 ;Bias block: replica of the stage-1 half circuit (on Vddb, Cbig decoupling)
TEXT 16 1040 Left 1 ;P replica: tail unit + input unit
TEXT 496 1040 Left 1 ;N replica: cascode unit + load unit
TEXT 912 1360 Left 1 ;cascode gates (EE4520 fig. 6: Ibcn, Ibcp)
TEXT 2416 264 Left 3 ;Stage 1: PMOS-input telescopic cascode
TEXT 2608 1344 Left 1 ;loads: N-Ncm units on vbn (replica), Ncm units on the CMFB line
TEXT 1904 264 Left 3 ;Stage 2 (vop) + Cc, Rz
TEXT 3264 264 Left 3 ;Stage 2 (von) + Cc, Rz
TEXT 3888 264 Left 3 ;CMFB (continuous time, on Vdd)
TEXT 16 1752 Left 3 ;Fixed test bench (Cin/Cfb = 4, Cload = Cin)
TEXT 2432 1808 Left 2 !.lib 'log018.l' TT
TEXT 2432 1848 Left 2 !.param VDD=1.8 VCM=0.9 VCMI=0.9
TEXT 2432 1888 Left 2 !.param Cin=2.15p Cfb={Cin/4} Cload={Cin} Rin=100Meg Rfb={4*Rin}
TEXT 2432 1928 Left 2 !.param VoutStep=1.2 VinStep={VoutStep/4} tstep=10n Tsettle=25n tstop={tstep+Tsettle+45n} trise=50p
TEXT 2432 1968 Left 2 !.param Lt=0.5u  Wt=4.3u
TEXT 2432 2008 Left 2 !.param Li=0.18u Wi=5u
TEXT 2432 2048 Left 2 !.param Lcp=0.25u Wcp=3u
TEXT 2432 2088 Left 2 !.param Lcn=0.25u Wcn=0.8u
TEXT 2432 2128 Left 2 !.param Ll=2u    Wl=2.8u
TEXT 2432 2168 Left 2 !.param Ld=0.25u Wd=8.5u
TEXT 2432 2208 Left 2 !.param N=9 Ncm=1 M2=11 Mcmt=2 Md=1
TEXT 2432 2248 Left 2 !.param Ibnp=6.2u kcn=6 kcp=4 Wbcn=0.34u Lbcn={Lcn} Wbcp=0.36u Lbcp={Lcp} Rdec=1k Cbig=10n
TEXT 2432 2288 Left 2 !.param Cc=0.77p Rz0=1.2k Rz={Rz0*(20/M2)*((Cc+1.2*Cin)/Cc)/4} Cls=0.68p Rb=2Meg Rcm=2Meg Ccm=50f Lcm=0.36u Wcm=8u
TEXT 2432 2328 Left 2 !.tran 0 {tstop} 0 2p
TEXT 2432 2368 Left 2 !.option plotwinsize=0 method=trap reltol=1e-4
TEXT 2432 2408 Left 2 !.meas tran vg25 FIND V(vip,vin) AT={tstep+Tsettle}
TEXT 2432 2448 Left 2 !.meas tran vod25 FIND V(von,vop) AT={tstep+Tsettle}
TEXT 2432 2488 Left 2 !.meas tran A25 PARAM 20*log10(VoutStep/(abs(vg25)+1n))
TEXT 2432 2528 Left 2 !.meas tran Ab25 PARAM 20*log10(VoutStep/(abs(VoutStep-vod25)+1n))
TEXT 2432 2568 Left 2 !.meas tran errmax MAX abs(VoutStep-V(von,vop)) FROM={tstep+Tsettle} TO={tstop}
TEXT 2432 2608 Left 2 !.meas tran Abfloor PARAM 20*log10(VoutStep/(errmax+1n))
TEXT 2432 2648 Left 2 !.meas tran Iset AVG -I(Vdd) FROM={tstep} TO={tstep+Tsettle}
TEXT 2432 2688 Left 2 !.meas tran Iq AVG -I(Vdd) FROM={tstep-5n} TO={tstep}
TEXT 2432 2728 Left 2 !.meas tran P_mW PARAM 1.8*max(Iset,Iq)*1e3
TEXT 2432 2768 Left 2 !.meas tran T30 WHEN 20*log10(VoutStep/(abs(VoutStep-V(von,vop))+1n))=30 RISE=1
TEXT 2432 2808 Left 2 !.meas tran T38p6 WHEN 20*log10(VoutStep/(abs(VoutStep-V(von,vop))+1n))=38.6 RISE=1
TEXT 2432 2848 Left 2 !.meas tran T30_step PARAM T30-tstep
TEXT 2432 2888 Left 2 !.meas tran T38p6_step PARAM T38p6-tstep
TEXT 2432 2928 Left 2 !.meas tran tau PARAM T38p6-T30
TEXT 2416 1752 Left 3 ;Parameters, Simulations & Measurements
